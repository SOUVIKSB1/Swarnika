{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://swarnika.onrender.com/api/:path*"
    },
    {
      "source": "/images/:path*",
      "destination": "https://swarnika.onrender.com/images/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://swarnika.onrender.com/uploads/:path*"
    }
  ]
}
